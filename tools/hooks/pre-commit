#!/usr/bin/env python3
"""Refuse un commit qui contient un document prof en clair (DS, Corr, Seq, Prep, archives, .tex à
corrigé : profkey.is_secret) : seul X.enc doit être commité. Garde-fou pour `git add -A` (alias
`ag`) si ./build.sh n'a pas encore tourné (c'est lui qui chiffre et remplit .gitignore).
Activé par : git config core.hooksPath tools/hooks"""
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import profkey  # noqa: E402

git = lambda *a: subprocess.run(["git", *a], capture_output=True, text=True, errors="replace").stdout
staged = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split("\0")
bad = [f for f in staged if f and profkey.is_secret(f, lambda f=f: git("show", f":{f}"))]
if bad:
    print("Commit refusé : documents prof en clair (seul X.enc doit être commité) :", file=sys.stderr)
    for f in bad:
        print(f"  {f}", file=sys.stderr)
    print("Lancer ./build.sh (chiffre et met à jour .gitignore), puis : git rm --cached <fichier>",
          file=sys.stderr)
    sys.exit(1)
